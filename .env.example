# ==========================================
# Prism Core: Environment Template
# ==========================================

# ------------------------------------------
# 1. Global Infrastructure (Databases & Brokers)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prism
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379

KAFKA_BROKERS=kafka:29092
KAFKA_BROKER=kafka:29092
ZOOKEEPER_CLIENT_PORT=2181

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpassword

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=test-qdrant-key-12345

# ------------------------------------------
# 2. Object storage & LLM credentials
# ------------------------------------------
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_REGION=us-east-1

# Local S3Mock only when using infra compose (comment out / empty for real AWS).
# S3_ENDPOINT=http://s3mock:9090
S3_BUCKET=prism-raw-documents
S3_BUCKET_NAME=prism-raw-documents
S3_REGION=us-east-1

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-your-anthropic-key-here

# ------------------------------------------
# 3. Microservice tuning
# ------------------------------------------
# Agentic Brain
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_TOKEN=your-cube-token
# CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/prism
WORK_QUEUE_POLL_SECONDS=2
WORK_QUEUE_STALE_SECONDS=900

# Web Dashboard (baked into Next image at build time)
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# API Gateway (Go)
APP_PORT=8080
KAFKA_INGESTTOPIC=doc_ingest_events

# S3 Connector (Go)
POSTGRES_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
GATEWAY_URL=http://api-gateway:8080/api/v1/upload
KAFKA_GROUPID=ingestor_group

# Triage Worker (Go)
APP_CONCURRENCY=100
APP_MAXRETRIES=3
KAFKA_CONSUMERGROUP=triage-worker-group
KAFKA_INGESTTOPIC=doc_ingest_events
KAFKA_DLQTOPIC=doc_dlq
KAFKA_GPUTOPIC=gpu_processing_queue

# SQS → Kafka Bridge (Go) — uses KAFKA_TOPIC for discovery (not ingest)
SQS_QUEUE_URL=http://elasticmq:9324/000000000000/s3_event_queue
SQS_ENDPOINT=http://elasticmq:9324
KAFKA_TOPIC=s3_discovery_events

# GPU Extractor (Python)
GOTENBERG_URL=http://gotenberg:3000/forms/libreoffice/convert
CHUNK_SIZE_PAGES=10

# Schema Aligner (Python)
CHUNK_SIZE_ROWS=10
FUZZY_MATCH_THRESHOLD=80
MAX_CONCURRENT_INFERENCES=5

# Storage Sync (Python)
CDC_MAX_CONCURRENT_INFERENCES=5
QDRANT_COLLECTION_NAME=document_chunks
CHUNK_ASSEMBLE_TIMEOUT_SECONDS=900
KAFKA_CONSUMER_GROUP_BIFURCATION=bifurcation-consumer-group
KAFKA_CONSUMER_GROUP_ALIGNED=aligned-consumer-group
KAFKA_CONSUMER_GROUP_AUTO_PROMOTE=auto-promote-consumer-group
KAFKA_CONSUMER_GROUP_SYSTEM_DLQ=system-dlq-consumer-group
SCHEMA_REGISTRY_PATH=apps/schema-aligner/src/core/registry.json

# ------------------------------------------
# 4. Host port mappings
# ------------------------------------------
API_GATEWAY_PORT=8080
AGENTIC_BRAIN_PORT=8001
WEB_DASHBOARD_PORT=3000
